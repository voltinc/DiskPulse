{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the DiskPulse Pro main window. The UI has no direct filesystem access; every file operation goes through the audited commands below.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "allow-app-info",
    "allow-exit-app",
    "allow-list-drives",
    "allow-get-cleanup-locations",
    "allow-get-cloud-locations",
    "allow-get-settings",
    "allow-save-settings",
    "allow-start-scan",
    "allow-cancel-scan",
    "allow-get-scan-summary",
    "allow-get-children",
    "allow-get-nodes",
    "allow-get-ancestors",
    "allow-search-nodes",
    "allow-get-treemap",
    "allow-get-breakdown",
    "allow-get-category-files",
    "allow-get-largest-files",
    "allow-start-duplicate-scan",
    "allow-cancel-duplicate-scan",
    "allow-get-duplicate-groups",
    "allow-trash-nodes",
    "allow-reveal-node",
    "allow-open-node",
    "allow-export-report",
    "allow-get-history",
    "allow-delete-history-entry",
    "allow-clear-history"
  ]
}
